#!/usr/bin/env python3
"""compact — n-level oracle.jsonl compaction (Python, no deps)."""
import json, sys, os, time
from collections import defaultdict
from datetime import datetime, timezone

PROTECTED = frozenset(("goal_created", "goal_done", "stall", "investigation"))

def main():
    oracle = sys.argv[1] if len(sys.argv) > 1 else "oracle.jsonl"
    dry_run = "--dry-run" in sys.argv
    stats_only = "--stats" in sys.argv
    max_passes = 5

    if stats_only:
        _print_stats(oracle)
        return

    for pass_num in range(1, max_passes + 1):
        with open(oracle) as f:
            lines = f.readlines()

        n = len(lines)
        if n < 100:
            if pass_num == 1:
                print(f"only {n} lines, skipping")
            return

        if pass_num == 1:
            print(f"oracle: {n} lines, {sum(len(l) for l in lines)} bytes")

        entries = [json.loads(l) for l in lines]
        result = _compact_once(entries)

        if len(result) == n:
            if pass_num > 1:
                print(f"  stable after {pass_num} passes")
            break

        tmp = oracle + ".tmp"
        with open(tmp, "w") as f:
            for e in result:
                f.write(json.dumps(e, separators=(",", ":")))
                f.write("\n")

        if dry_run:
            print(f"dry run: {n} -> {len(result)} lines")
            os.remove(tmp)
            return
        else:
            os.rename(tmp, oracle)
            print(f"compacted: {n} -> {len(result)} lines")

def _compact_once(entries):
    now = time.time()
    n = len(entries)
    tail_n = min(50, n)
    tail = entries[-tail_n:]
    head = entries[:-tail_n] if tail_n < n else []

    keep = []
    d0_old, d0_fresh = [], []
    d1_old, d1_fresh = [], []
    d2_old, d2_fresh = [], []
    higher = []

    for e in head:
        if e["kind"] in PROTECTED:
            keep.append(e)
            continue
        cd = e.get("cd", 0)
        age = now - _epoch(e["ts"])
        if cd == 0:
            (d0_old if age > 86400 else d0_fresh).append(e)
        elif cd == 1:
            (d1_old if age > 604800 else d1_fresh).append(e)
        elif cd == 2:
            (d2_old if age > 2592000 else d2_fresh).append(e)
        else:
            higher.append(e)

    d1_new = _compact_groups(d0_old, lambda e: e["goal_id"] + "|" + e["ts"][:13], 1)
    d2_new = _roll_up_groups(d1_old, lambda e: e["goal_id"] + "|" + e["ts"][:10], 2)
    d3_new = _roll_up_groups(d2_old, lambda e: e["goal_id"] + "|" + e["ts"][:7], 3)

    result = keep + higher + d3_new + d2_fresh + d2_new + d1_fresh + d1_new + d0_fresh + tail
    result.sort(key=lambda e: e["ts"])
    return result

def _print_stats(oracle):
    """Print oracle statistics without modifying the file."""
    with open(oracle) as f:
        entries = [json.loads(l) for l in f]

    n = len(entries)
    now = time.time()

    by_kind = defaultdict(int)
    by_goal = defaultdict(lambda: {"entries": 0, "kinds": defaultdict(int)})
    by_depth = defaultdict(int)
    oldest = newest = None

    for e in entries:
        by_kind[e["kind"]] += 1
        g = by_goal[e.get("goal_id", "?")]
        g["entries"] += 1
        g["kinds"][e["kind"]] += 1
        by_depth[e.get("cd", 0)] += 1
        if oldest is None or e["ts"] < oldest: oldest = e["ts"]
        if newest is None or e["ts"] > newest: newest = e["ts"]

    print(f"oracle: {oracle}")
    print(f"  entries: {n}")
    print(f"  span: {oldest} .. {newest}")
    print(f"  size: {os.path.getsize(oracle)} bytes")
    print()

    print("by depth:")
    for d in sorted(by_depth):
        label = {0: "D0 raw", 1: "D1 hourly", 2: "D2 daily", 3: "D3 weekly"}.get(d, f"D{d}")
        print(f"  {label}: {by_depth[d]}")
    print()

    print("by kind:")
    for k in sorted(by_kind, key=by_kind.get, reverse=True):
        print(f"  {k}: {by_kind[k]}")
    print()

    print("by goal:")
    created = {e["goal_id"] for e in entries if e["kind"] == "goal_created"}
    done = {e["goal_id"] for e in entries if e["kind"] == "goal_done"}
    for gid in sorted(by_goal):
        g = by_goal[gid]
        status = "done" if gid in done else "active" if gid in created else "?"
        print(f"  {gid} [{status}]: {g['entries']} entries")

def _epoch(ts):
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()

def _compact_groups(entries, key_fn, cd):
    groups = defaultdict(list)
    for e in entries:
        groups[key_fn(e)].append(e)
    out = []
    for group in groups.values():
        hb = pr = ex = ke = dr = 0
        snap = None
        for e in group:
            k = e["kind"]
            if k == "heartbeat":
                hb += 1
                if e.get("progress"): pr += 1
                if e.get("snapshot") is not None: snap = e["snapshot"]
            elif k == "experiment": ex += 1
            elif k == "decision":
                v = e.get("verdict")
                if v == "kept": ke += 1
                elif v == "dropped": dr += 1
        out.append({
            "ts": group[0]["ts"], "kind": "compaction",
            "goal_id": group[0]["goal_id"], "cd": cd,
            "n": len(group), "window": [group[0]["ts"], group[-1]["ts"]],
            "summary": {"heartbeats": hb, "progress": pr, "experiments": ex,
                        "kept": ke, "dropped": dr, "snapshot": snap}
        })
    return out

def _roll_up_groups(entries, key_fn, cd):
    """Roll up higher-depth compaction entries into the next level."""
    groups = defaultdict(list)
    for e in entries:
        groups[key_fn(e)].append(e)
    out = []
    for group in groups.values():
        s = lambda f: sum(e.get("summary", {}).get(f, 0) for e in group)
        snap = None
        for e in group:
            v = e.get("summary", {}).get("snapshot")
            if v is not None: snap = v
        out.append({
            "ts": group[0]["ts"], "kind": "compaction",
            "goal_id": group[0]["goal_id"], "cd": cd,
            "n": sum(e.get("n", 1) for e in group),
            "window": [group[0]["ts"], group[-1]["ts"]],
            "summary": {"heartbeats": s("heartbeats"), "progress": s("progress"),
                        "experiments": s("experiments"), "kept": s("kept"),
                        "dropped": s("dropped"), "snapshot": snap}
        })
    return out

if __name__ == "__main__":
    main()
