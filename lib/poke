#!/usr/bin/env python3
"""poke — one heartbeat tick. Measure, classify, log, report trajectory."""
import json, sys, os, subprocess, time

sys.path.insert(0, os.path.dirname(__file__))
import oracle as orc

SPARK = "▁▂▃▄▅▆▇█"

def main():
    path = sys.argv[1] if len(sys.argv) > 1 else "oracle.jsonl"

    lock = path + ".poke.lock"
    if not _acquire_lock(lock, path):
        return

    try:
        _poke(path)
    finally:
        try:
            os.remove(lock)
        except OSError:
            pass


def _acquire_lock(lock, path):
    if os.path.exists(lock):
        try:
            age = time.time() - os.path.getmtime(lock)
        except OSError:
            age = 0
        hb_m = 30
        try:
            st = orc.state(path)
            for g in st["goals"]:
                if g["status"] == "active":
                    hb_m = g["config"].get("heartbeat_m", 30)
                    break
        except Exception:
            pass
        max_age = hb_m * 120
        if age < max_age:
            print(f"poke already running ({int(age)}s old), skipping", file=sys.stderr)
            return False
        print(f"stale lock ({int(age)}s > {max_age}s), forcing poke", file=sys.stderr)
    with open(lock, "w") as f:
        f.write(str(os.getpid()))
    return True


def _poke(path):
    st = orc.state(path)
    now = orc.now_ts()
    appends = []

    goals_metrics = {}
    for goal in st["goals"]:
        if goal["status"] == "active":
            goals_metrics[goal["goal_id"]] = goal["metrics"]

    series = orc.metric_series(st["entries"], goals_metrics)

    for goal in st["goals"]:
        if goal["status"] != "active":
            continue

        gid = goal["goal_id"]
        prev_snapshot = goal.get("snapshot", {})
        if not prev_snapshot:
            prev_snapshot = {m["name"]: m["baseline"] for m in goal["metrics"] if "baseline" in m}
        prev_stale = goal.get("stale_pokes", 0)
        poke_max = goal.get("poke_max", 3)
        metrics = goal.get("metrics", [])

        # Measure
        snapshot = {}
        for m in metrics:
            cmd = m.get("measure")
            if not cmd:
                continue
            try:
                r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=30)
                val = r.stdout.strip().split("\n")[-1]
                snapshot[m["name"]] = _parse_num(val)
            except (subprocess.TimeoutExpired, ValueError, IndexError):
                pass

        # Classify
        delta = {}
        progress = False
        for m in metrics:
            name = m["name"]
            if name in snapshot and name in prev_snapshot:
                d = snapshot[name] - prev_snapshot[name]
                delta[name] = round(d, 4)
                direction = m.get("direction", "down")
                baseline = m.get("baseline", prev_snapshot[name])
                threshold = abs(baseline) * 0.05 if baseline else 0.05
                if (direction == "down" and d < -threshold) or \
                   (direction == "up" and d > threshold):
                    progress = True

        stale = 0 if progress else prev_stale + 1

        hb = {
            "ts": now, "kind": "heartbeat", "goal_id": gid,
            "snapshot": snapshot, "delta": delta,
            "progress": progress, "stale_pokes": stale
        }
        appends.append(hb)

        # Report with trajectory
        parts = []
        for m in metrics:
            name = m["name"]
            if name not in snapshot:
                continue
            val = snapshot[name]
            target = m.get("target")
            pts = series.get(gid, {}).get(name, [])
            values = [p["v"] for p in pts] + [val]

            chunk = f"{name}:{val}"
            if target is not None:
                baseline = m.get("baseline", values[0])
                direction = m.get("direction", "down")
                pct = orc.progress_pct(val, baseline, target, direction)
                chunk += f" ({pct:.0f}%)"

            if len(values) >= 3:
                chunk += " " + _sparkline(values[-10:])

            if len(values) >= 2:
                times = [p["t"] for p in pts] + [time.time()]
                vel = orc.velocity(times, values)
                if vel != 0:
                    chunk += f" v:{vel:+.2f}/h"

            parts.append(chunk)

        status = "progress" if progress else f"stale {stale}/{poke_max}"
        print(f"[{gid}] {status} | " + " | ".join(parts))

        # Stall detection
        if stale >= poke_max:
            stall = {
                "ts": now, "kind": "stall", "goal_id": gid,
                "stale_pokes": stale, "action": "investigation_needed"
            }
            appends.append(stall)
            print(f"[{gid}] STALL: {stale} pokes, investigation needed")

    # Compaction check
    try:
        n = st["total_entries"] + len(appends)
        size = os.path.getsize(path)
        if n > 500 or size > 1_000_000:
            compact = os.path.join(os.path.dirname(__file__), "compact")
            subprocess.run(["python3", compact, path], capture_output=True)
            print(f"compacted ({n} entries, {size} bytes)")
    except (FileNotFoundError, OSError):
        pass

    orc.append(path, *appends)


def _sparkline(values):
    if not values:
        return ""
    lo, hi = min(values), max(values)
    if lo == hi:
        return SPARK[4] * min(len(values), 10)
    return "".join(SPARK[min(int((v - lo) / (hi - lo) * 7), 7)] for v in values[-10:])


def _parse_num(s):
    s = s.strip()
    try:
        return int(s)
    except ValueError:
        return float(s)


if __name__ == "__main__":
    main()
