#!/usr/bin/env python3
"""status — reconstruct current state from oracle.jsonl."""
import json, sys, os

sys.path.insert(0, os.path.dirname(__file__))
import oracle as orc

def main():
    path = sys.argv[1] if len(sys.argv) > 1 else "oracle.jsonl"
    raw = "--raw" in sys.argv

    st = orc.state(path)
    out = {k: v for k, v in st.items() if k != "entries"}

    if raw:
        print(json.dumps(out, separators=(",", ":")))
    else:
        print(json.dumps(out, indent=2))

    if not raw:
        for g in st["goals"]:
            if g["status"] != "active":
                continue
            pm = g["poke_max"]
            sp = g["stale_pokes"]
            print(f'[{g["goal_id"]}] pokes:{g["pokes"]} stale:{sp}/{pm} '
                  f'experiments:{len(g["active_experiments"])} '
                  f'investigations:{g["investigations"]}', file=sys.stderr)

if __name__ == "__main__":
    main()
