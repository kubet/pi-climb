#!/usr/bin/env bash
set -euo pipefail
# Install /climb skill for Claude Code and/or omp.
# Usage: ./install [--global|--project|--omp|--all]
#   --global:  symlink to ~/.claude/skills/climb (default)
#   --project: symlink to .claude/skills/climb in current directory
#   --omp:     symlink to ~/.omp/agent/skills/climb
#   --all:     install to both global and omp

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_SRC="$SCRIPT_DIR/skill"
MODE="${1:---global}"

_install() {
  local TARGET="$1"
  local DIR
  DIR="$(dirname "$TARGET")"
  mkdir -p "$DIR"

  if [[ -L "$TARGET" ]]; then
    EXISTING=$(readlink "$TARGET")
    if [[ "$EXISTING" == "$SKILL_SRC" ]]; then
      echo "already installed: $TARGET"
      return 0
    fi
    echo "updating: $TARGET"
    rm "$TARGET"
  elif [[ -d "$TARGET" ]]; then
    echo "error: $TARGET exists and is not a symlink. Remove it first." >&2
    return 1
  fi

  ln -s "$SKILL_SRC" "$TARGET"
  echo "installed: $TARGET -> $SKILL_SRC"
}

case "$MODE" in
  --global)
    _install "$HOME/.claude/skills/climb"
    ;;
  --project)
    _install "$(pwd)/.claude/skills/climb"
    ;;
  --omp)
    _install "$HOME/.omp/agent/skills/climb"
    ;;
  --all)
    _install "$HOME/.claude/skills/climb"
    _install "$HOME/.omp/agent/skills/climb"
    ;;
  *)
    echo "usage: install [--global|--project|--omp|--all]" >&2
    exit 1
    ;;
esac
